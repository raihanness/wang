DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=wang.domcloud.co,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://wang.domcloud.co
DJANGO_TIME_ZONE=Asia/Jakarta
DB_ENGINE=mariadb
DB_NAME=wang
DB_USER=wang
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Cloudflare Turnstile Security (Leave as test keys for dev)
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_ENABLED=1

# Email configuration (for Password Reset)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Wang <noreply@wang.app>

