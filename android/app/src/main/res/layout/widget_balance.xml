<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="14dp">

    <!-- Header bar: Squircle Icon + Today & Date + Live badge -->
    <LinearLayout
        android:id="@+id/widget_balance_top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <!-- Squircle App Icon -->
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_widget_squircle_peach"
            android:src="@drawable/ic_widget_wallet"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/app_name" />

        <!-- Title & Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_title" />

            <TextView
                android:id="@+id/tv_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed, 06 Oct 2026"
                android:textSize="11sp"
                android:textColor="@color/widget_text_subtitle"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Sync badge -->
        <TextView
            android:id="@+id/tv_widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_muted"
            android:background="@drawable/bg_widget_bottom_panel"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Center Section: Today's Expense Hero -->
    <LinearLayout
        android:id="@+id/widget_balance_click_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_widget_hero_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_today_expenses_label"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_muted" />

        <TextView
            android:id="@+id/tv_widget_hero_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Section: 2 Metric Columns (Budget & Total Balance with Privacy) -->
    <LinearLayout
        android:id="@+id/widget_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_widget_bottom_panel"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">

        <!-- Column 1: Remaining Budget (or Today's Income) -->
        <LinearLayout
            android:id="@+id/btn_widget_balance_col1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_widget_balance_col1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_daily_budget_label"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_widget_balance_col1_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_value"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Vertical Divider (ImageView for 100% RemoteViews compatibility) -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_divider"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null" />

        <!-- Column 2: Total Balance with Privacy Toggle -->
        <LinearLayout
            android:id="@+id/btn_widget_balance_col2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_widget_balance_col2_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_total_balance_label"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_muted"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/btn_widget_balance_privacy"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:padding="1dp"
                    android:src="@drawable/ic_widget_visibility"
                    android:contentDescription="Toggle balance visibility"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_balance_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_balance"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_value"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
