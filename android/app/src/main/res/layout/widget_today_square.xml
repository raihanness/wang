<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="14dp">

    <!-- Top Row: Icon Squircle + Today & Date -->
    <LinearLayout
        android:id="@+id/widget_square_top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <!-- Squircle App Icon -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_squircle_peach"
            android:src="@drawable/ic_widget_wallet"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/app_name" />

        <!-- Title & Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_today_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_title"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_title" />

            <TextView
                android:id="@+id/tv_widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed, 06 Oct 2026"
                android:textSize="12sp"
                android:textColor="@color/widget_text_subtitle"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Section: Total Balance -->
    <LinearLayout
        android:id="@+id/widget_square_balance_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_total_balance_label"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_muted" />

        <TextView
            android:id="@+id/tv_widget_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_default_balance"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_title"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Section: 2 Columns (Today's Expenses & Today's Income) -->
    <LinearLayout
        android:id="@+id/widget_square_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_widget_bottom_panel"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">

        <!-- Column 1: Today's Expenses -->
        <LinearLayout
            android:id="@+id/btn_widget_square_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_expenses_label"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_widget_today_expenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_value"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Vertical Divider (ImageView for 100% RemoteViews compatibility) -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_widget_divider"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null" />

        <!-- Column 2: Today's Income -->
        <LinearLayout
            android:id="@+id/btn_widget_square_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_today_income_label"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_widget_today_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_value"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
